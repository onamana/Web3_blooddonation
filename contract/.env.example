# Sepolia RPC (Alchemy/Infura 등에서 발급). backend/.env.example 의 SEPOLIA_RPC_URL과 같은 값 사용 가능
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# 배포용 지갑 키. 절대 커밋 금지. backend의 BACKEND_SIGNER_PRIVATE_KEY와는 별개 키를 써도 됨
DEPLOYER_PRIVATE_KEY=

# 배포 후 발급자 롤(ISSUER_ROLE)을 부여할 백엔드 relayer 주소
# (backend .env의 BACKEND_SIGNER_PRIVATE_KEY에 대응하는 지갑 주소)
BACKEND_SIGNER_ADDRESS=

# Etherscan 검증(verify)용 API 키, 선택
ETHERSCAN_API_KEY=
