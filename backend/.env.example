PORT=4000
CHAIN_ID=11155111
BLOOD_CENTER_NAME=대전혈액원
# 기본 저장 위치: backend/data/certificates.sqlite (Node >=22.13 필요)
# CERTIFICATE_DB_PATH=

# Sepolia RPC (Alchemy/Infura 등에서 발급)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# 온체인 write(record)를 백엔드가 직접 보내는 relayer 지갑용 키. 절대 커밋 금지.
BACKEND_SIGNER_PRIVATE_KEY=

# A가 배포한 뒤 채워넣기
DONATION_CONTRACT_ADDRESS=

# A가 배포한 헌혈 증서(ERC-721) 컨트랙트 주소. 미설정 시 /certificate 는 501로 응답한다.
CERTIFICATE_CONTRACT_ADDRESS=

# BloodCertificate가 배포된 블록 번호 (deploy.js 출력 참고). eth_getLogs의 fromBlock으로 쓰인다 —
# 비워두면 0(genesis)부터 조회하는데, 일부 RPC(Infura 등)는 블록 범위 자체를 제한해서
# "range exceeds limit" 에러로 /certificate 관련 라우트가 전부 깨진다.
CERTIFICATE_DEPLOY_BLOCK=

# B(DID 모듈) API 베이스 URL
DID_MODULE_BASE_URL=http://localhost:5001
DID_ISSUE_API_KEY=

# 초대형 데모 로그인. production에서는 암호 16자 이상, 세션 키 32자 이상 필수.
DEMO_ACCESS_PASSWORD=
DEMO_SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
