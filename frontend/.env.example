# 백엔드 API 기본 주소 (backend/ 참고). 미설정 시 http://localhost:4000 사용
VITE_API_BASE_URL=http://localhost:4000

# true: 샘플 아트보드 기준 목업 데이터 사용 (기본값, 스마트컨트랙트/DID 모듈 미배포 상태에 대응)
# false: 실제 백엔드 /donation, /certificate, /match API 호출
VITE_DEMO_MODE=true

# 트랜잭션 해시를 확인할 블록 익스플로러 (컨트랙트는 Sepolia 배포)
VITE_EXPLORER_BASE_URL=https://sepolia.etherscan.io
VITE_CHAIN_ID=0xaa36a7

# BloodCertificate(ERC-721) 컨트랙트 주소. 양도는 소유자의 MetaMask가 직접
# safeTransferFrom()을 호출하므로 프론트가 이 주소를 알아야 한다 (A가 배포 후 전달).
VITE_CERTIFICATE_CONTRACT_ADDRESS=
